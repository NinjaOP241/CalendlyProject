{
  "name": "CalendlyProject",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec tsx src/server.ts",
    "worker:slot": "nodemon --watch src --ext ts --exec tsx src/temporal/workers/slot-generation.worker.ts",
    "worker:notification": "nodemon --watch src --ext ts --exec tsx src/temporal/workers/booking-notification.worker.ts",
    "workers:dev": "concurrently -c \"magenta,yellow\" -n \"SLOT,EMAIL\" \"pnpm run worker:slot\" \"pnpm run worker:notification\"",
    "prisma:format": "npx prisma format",
    "prisma:migrate": "npx prisma migrate dev",
    "prisma:generate": "npx prisma generate",
    "prisma:all": "npm run prisma:format && npm run prisma:migrate && npm run prisma:generate",
    "prisma:studio": "npx prisma studio",
    "google:setup": "tsx src/utils/google-setup.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@11.0.8",
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@temporalio/activity": "^1.21.1",
    "@temporalio/client": "^1.21.1",
    "@temporalio/worker": "^1.21.1",
    "@temporalio/workflow": "^1.21.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "googleapis": "^174.0.1",
    "luxon": "^3.7.2",
    "nanoid": "^6.0.0",
    "nodemailer": "^9.0.4",
    "pg": "^8.22.0",
    "slug": "^12.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/luxon": "^3.7.2",
    "@types/node": "^26.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/slug": "^5.0.9",
    "concurrently": "^10.0.4",
    "nodemon": "^3.1.14",
    "prisma": "^7.8.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
